# Copy to .env.cloud (git-ignored) and fill in from the Supabase dashboard of the development
# project (ADR-002). Never commit or paste these values. No spaces or quotes around values.

# Project Settings → Data API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → publishable (anon) key
SUPABASE_ANON_KEY=
# Project Settings → API Keys → secret (service_role) key. Server side only.
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Connection string → URI (session mode, port 5432), with the database password.
SUPABASE_DB_URL=

# Optional. Defaults are set by scripts/cloud.mjs.
# VIONX_SERVICE_SECRET=      # must equal the Vault entry `vionx_service_secret`
# ANTHROPIC_API_KEY=         # without it the FakeAiProvider is used
# ALLOWED_ORIGINS=http://localhost:5173
# PORT=54331                 # port of `pnpm fn:serve`
