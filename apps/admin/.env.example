# Copy to apps/admin/.env.local (or set in Cloudflare Pages). VITE_* values are bundled; never secrets.
VITE_API_URL=http://localhost:54321/functions/v1
# Supabase project URL and publishable (anon) key: `pnpm exec supabase status` prints the local ones.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
