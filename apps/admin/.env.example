# Copy to apps/admin/.env.local (or set in Cloudflare Pages). VITE_* values are bundled; never secrets.
VITE_API_URL=http://localhost:54331/functions/v1
# Supabase project URL and publishable (anon) key (SUPABASE_URL / SUPABASE_ANON_KEY of .env.cloud).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SENTRY_DSN=
