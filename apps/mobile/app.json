{
  "expo": {
    "name": "VionX",
    "slug": "vionx",
    "scheme": "vionx",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "vn.vionx.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "VionX dùng camera để con chụp ảnh khi hoàn thành nhiệm vụ.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {}
    }
  }
}
