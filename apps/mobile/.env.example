# Copy to apps/mobile/.env.local. EXPO_PUBLIC_* values are bundled into the app (never secrets).
# Android emulator → `pnpm fn:serve` on the host machine (deployed: https://<ref>.supabase.co/functions/v1):
EXPO_PUBLIC_API_URL=http://10.0.2.2:54331/functions/v1
# Supabase Cloud development project (same values as SUPABASE_URL / SUPABASE_ANON_KEY in .env.cloud).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key. Grants no table access.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth *Web* client id (Google Cloud console). Empty = Google button explains it is off.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: Sentry DSN for crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
