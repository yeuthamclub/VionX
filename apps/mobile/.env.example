# Copy to apps/mobile/.env.local. EXPO_PUBLIC_* values are bundled into the app (never secrets).
# Android emulator → host machine's local Supabase:
EXPO_PUBLIC_API_URL=http://10.0.2.2:54321/functions/v1
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
# Publishable (anon) key: `pnpm exec supabase status` prints the local one. Grants no table access.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Google OAuth *Web* client id (Google Cloud console). Empty = Google button explains it is off.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: Sentry DSN for crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
