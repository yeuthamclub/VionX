{
  "openapi": "3.1.0",
  "info": {
    "title": "VionX API",
    "version": "1.0.0",
    "description": "Single entry point for the VionX Android app and admin SPA (Supabase Edge Function `api`)."
  },
  "servers": [
    {
      "url": "/functions/v1",
      "description": "Supabase Edge Functions base"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Parent: Supabase Auth access token (phone OTP or Google)."
      },
      "childSession": {
        "type": "apiKey",
        "in": "header",
        "name": "x-vionx-child-session",
        "description": "Child: opaque session token from POST /v1/auth/child/login."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "requestId": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "db": {
                "$ref": "#/components/schemas/HealthCheck"
              },
              "storage": {
                "$ref": "#/components/schemas/HealthCheck"
              },
              "queue": {
                "$ref": "#/components/schemas/HealthCheck"
              },
              "ai": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/HealthCheck"
                  },
                  {
                    "description": "ANTHROPIC_API_KEY is configured (no call made)."
                  }
                ]
              }
            },
            "required": [
              "db",
              "storage",
              "queue",
              "ai"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "time",
          "requestId",
          "checks"
        ]
      },
      "HealthCheck": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "critical": {
            "type": "boolean"
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "critical"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "FORBIDDEN_HOUSEHOLD",
              "NOT_FOUND",
              "CONFLICT",
              "CONSENT_REQUIRED",
              "REWARD_CAP_REACHED",
              "TUTOR_QUOTA_REACHED",
              "RATE_LIMITED",
              "NOT_IMPLEMENTED",
              "SERVICE_UNAVAILABLE",
              "INTERNAL",
              "INVALID_CREDENTIALS",
              "ACCOUNT_LOCKED",
              "ACCOUNT_DISABLED"
            ],
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "example": "Request body is invalid"
          },
          "details": {},
          "requestId": {
            "type": "string",
            "example": "a1b2c3d4-..."
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "households": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "$ref": "#/components/schemas/HouseholdRole"
                },
                "timezone": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "role",
                "timezone"
              ]
            }
          },
          "adminPermissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminPermission"
            }
          }
        },
        "required": [
          "userId",
          "phone",
          "email",
          "displayName",
          "households",
          "adminPermissions"
        ]
      },
      "HouseholdRole": {
        "type": "string",
        "enum": [
          "OWNER",
          "GUARDIAN"
        ]
      },
      "AdminPermission": {
        "type": "string",
        "enum": [
          "SUPER_ADMIN",
          "CONTENT_ADMIN",
          "CURRICULUM_EDITOR",
          "CONTENT_REVIEWER",
          "LIBRARIAN",
          "SUPPORT",
          "ANALYST"
        ]
      },
      "HouseholdResponse": {
        "type": "object",
        "properties": {
          "household": {
            "$ref": "#/components/schemas/Household"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Student"
            }
          }
        },
        "required": [
          "household",
          "students"
        ]
      },
      "Household": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/HouseholdRole"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "timezone",
          "role",
          "createdAt"
        ]
      },
      "Student": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
          },
          "displayName": {
            "type": "string"
          },
          "birthYear": {
            "type": "integer"
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "avatar": {
            "$ref": "#/components/schemas/Avatar"
          },
          "childLoginId": {
            "type": "string",
            "example": "vx-k7m2pq",
            "description": "`vx-` + 6 characters"
          },
          "status": {
            "$ref": "#/components/schemas/StudentStatus"
          },
          "lockedUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "failedAttempts": {
            "type": "integer",
            "minimum": 0
          },
          "activeSessions": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "displayName",
          "birthYear",
          "grade",
          "avatar",
          "childLoginId",
          "status",
          "lockedUntil",
          "failedAttempts",
          "activeSessions",
          "createdAt",
          "updatedAt"
        ]
      },
      "Avatar": {
        "type": "string",
        "enum": [
          "owl",
          "fox",
          "cat",
          "dog",
          "panda",
          "rabbit",
          "tiger",
          "turtle"
        ]
      },
      "StudentStatus": {
        "type": "string",
        "enum": [
          "active",
          "locked",
          "disabled"
        ]
      },
      "HouseholdCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Gia đình Minh"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "example": "Asia/Ho_Chi_Minh"
          }
        },
        "required": [
          "name"
        ]
      },
      "StudentCreateResponse": {
        "type": "object",
        "properties": {
          "student": {
            "$ref": "#/components/schemas/Student"
          },
          "credentials": {
            "$ref": "#/components/schemas/ChildCredentials"
          }
        },
        "required": [
          "student",
          "credentials"
        ]
      },
      "ChildCredentials": {
        "type": "object",
        "properties": {
          "childLoginId": {
            "type": "string",
            "example": "vx-k7m2pq",
            "description": "`vx-` + 6 characters"
          },
          "pin": {
            "type": "string",
            "pattern": "^\\d{4,8}$",
            "example": "582913",
            "description": "Shown once on the credential card; never stored in clear."
          }
        },
        "required": [
          "childLoginId",
          "pin"
        ]
      },
      "StudentCreateRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Minh"
          },
          "birthYear": {
            "type": "integer",
            "example": 2014
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "example": 6
          },
          "avatar": {
            "$ref": "#/components/schemas/Avatar"
          },
          "pin": {
            "type": "string",
            "pattern": "^\\d{4,8}$",
            "example": "582913",
            "description": "Omit to let the server generate a 6-digit PIN."
          }
        },
        "required": [
          "displayName",
          "birthYear",
          "grade"
        ]
      },
      "StudentPatchRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "example": "Minh"
          },
          "birthYear": {
            "type": "integer",
            "example": 2014
          },
          "grade": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "example": 6
          },
          "avatar": {
            "$ref": "#/components/schemas/Avatar"
          }
        }
      },
      "ResetPinResponse": {
        "type": "object",
        "properties": {
          "credentials": {
            "$ref": "#/components/schemas/ChildCredentials"
          },
          "revokedSessions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "credentials",
          "revokedSessions"
        ]
      },
      "ResetPinRequest": {
        "type": "object",
        "properties": {
          "pin": {
            "type": "string",
            "pattern": "^\\d{4,8}$",
            "example": "582913",
            "description": "Omit to generate a new 6-digit PIN."
          },
          "revokeSessions": {
            "type": "boolean",
            "description": "Also sign the child out everywhere."
          }
        }
      },
      "RevokeSessionsResponse": {
        "type": "object",
        "properties": {
          "revokedSessions": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "revokedSessions"
        ]
      },
      "DisableRequest": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean",
            "description": "Default true. false re-enables the child login."
          }
        }
      },
      "ChildLoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Opaque; send as `x-vionx-child-session`."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "student": {
            "$ref": "#/components/schemas/ChildProfile"
          }
        },
        "required": [
          "token",
          "expiresAt",
          "student"
        ]
      },
      "ChildProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
          },
          "displayName": {
            "type": "string"
          },
          "grade": {
            "type": "integer"
          },
          "avatar": {
            "$ref": "#/components/schemas/Avatar"
          }
        },
        "required": [
          "id",
          "displayName",
          "grade",
          "avatar"
        ]
      },
      "ChildLoginRequest": {
        "type": "object",
        "properties": {
          "childLoginId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "example": "vx-k7m2pq"
          },
          "pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "example": "582913"
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "example": "android-6f1c…"
          }
        },
        "required": [
          "childLoginId",
          "pin",
          "deviceId"
        ]
      },
      "ChildSession": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "student": {
            "$ref": "#/components/schemas/ChildProfile"
          }
        },
        "required": [
          "expiresAt",
          "student"
        ]
      },
      "ChildLogoutResponse": {
        "type": "object",
        "properties": {
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "revoked"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Service health",
        "description": "Checks the database, storage and the pgmq \"events\" queue, and reports whether an Anthropic API key is configured. Public; no authentication.",
        "responses": {
          "200": {
            "description": "All critical checks pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "At least one critical check failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Signed-in parent account",
        "description": "Profile, households and admin permissions of the Supabase Auth user.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (UNAUTHENTICATED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/household": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Create the household",
        "description": "Creates the parent’s household with the parent as OWNER. One household per parent in v1.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HouseholdCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseholdResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (UNAUTHENTICATED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (CONFLICT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "The parent’s household and children",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Household",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HouseholdResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (UNAUTHENTICATED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not in your household (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Add a child",
        "description": "Creates the child profile and login. The response carries the one-time credentials (login id + PIN); the PIN is never retrievable again.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (UNAUTHENTICATED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not in your household (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/{id}": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "A child in the parent’s household",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Child",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (UNAUTHENTICATED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not in your household (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "identity"
        ],
        "summary": "Edit a child profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3f9a5b2c-1d4e-4f6a-8b7c-9d0e1f2a3b4c"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentPatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (VALIDATION_FAILED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials (UNAUTHENTICATED, INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not in your household (NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students/{id}/reset-pin": {
