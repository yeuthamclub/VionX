# Copy to supabase/functions/.env (git-ignored); `supabase functions serve` loads it automatically.
# SUPABASE_URL, SUPABASE_DB_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime.

# Shared secret for system calls (pg_cron → worker, ai-batch). Must match the Vault entry
# `vionx_service_secret` (supabase/seed.sql sets this local value).
VIONX_SERVICE_SECRET=local-dev-service-secret

# Optional locally; required in staging/production. Use a key with a low spend limit.
ANTHROPIC_API_KEY=

# Comma-separated browser origins allowed to call the api (admin SPA). Empty = none.
ALLOWED_ORIGINS=http://localhost:5173

APP_VERSION=0.0.0-local
