{"item": "T6-GCD-0001", "params": [{"name": "g", "type": "int", "min": 2, "max": 12}, {"name": "p", "type": "int", "min": 2, "max": 9}, {"name": "q", "type": "int", "min": 2, "max": 9}], "constraints": ["gcd(p, q) == 1", "p != q"], "answerExpr": "g", "distractorExprs": ["g * p * q"], "render": {"stem": "Tìm ƯCLN({{g * p}}, {{g * q}}).", "explanation": "{{g * p}} = {{g}} · {{p}} và {{g * q}} = {{g}} · {{q}}, mà {{p}} và {{q}} không có ước chung nào khác 1, nên ƯCLN = {{g}}."}}
{"item": "T6-FRAC-0001", "params": [{"name": "n", "type": "int", "min": 5, "max": 15}, {"name": "a", "type": "int", "min": 1, "max": 9}, {"name": "b", "type": "int", "min": 2, "max": 9}], "constraints": ["a + b < n", "gcd(a + b, n) == 1", "a * b != a + b"], "answerExpr": "concat(\"$\\\\frac{\", string(a + b), \"}{\", string(n), \"}$\")", "distractorExprs": ["concat(\"$\\\\frac{\", string(a + b), \"}{\", string(2 * n), \"}$\")", "concat(\"$\\\\frac{\", string(a * b), \"}{\", string(n), \"}$\")"], "render": {"stem": "Tính $\\frac{{{a}}}{{{n}}} + \\frac{{{b}}}{{{n}}}$.", "explanation": "Giữ nguyên mẫu {{n}}, cộng tử: {{a}} + {{b}} = {{a + b}}."}}
{"item": "T6-DEC-0001", "params": [{"name": "x", "type": "decimal", "min": 0.2, "max": 9.8, "step": 0.1}, {"name": "k", "type": "int", "min": 2, "max": 9}], "constraints": ["mod(x * 10, 10) != 0"], "answerExpr": "x * k", "distractorExprs": ["x * k * 10"], "render": {"stem": "Tính ${{x}} \\times {{k}}$.", "decimal": "comma"}}
