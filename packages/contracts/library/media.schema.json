{
  "$id": "https://vionx.app/schemas/library/media.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ICON",
        "SVG",
        "IMAGE"
      ]
    },
    "file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.svg$"
    },
    "storagePath": {
      "type": "string"
    },
    "alt": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "NEEDS_REVIEW",
        "APPROVED",
        "REJECTED"
      ]
    }
  },
  "required": [
    "code",
    "kind",
    "alt",
    "license",
    "reviewStatus"
  ],
  "additionalProperties": false
}
