{
  "$id": "https://vionx.app/schemas/library/template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "item": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "params": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "int"
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "step": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "type",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "decimal"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "name",
              "type",
              "min",
              "max",
              "step"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "choice"
              },
              "values": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              }
            },
            "required": [
              "name",
              "type",
              "values"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "words"
              },
              "list": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "name",
              "type",
              "list"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "constraints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answerExpr": {
      "type": "string",
      "minLength": 1
    },
    "render": {
      "type": "object",
      "properties": {
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "ttsText": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "decimal": {
          "type": "string",
          "enum": [
            "comma",
            "point"
          ]
        }
      },
      "required": [
        "stem"
      ],
      "additionalProperties": false
    },
    "distractorExprs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "item",
    "params",
    "answerExpr",
    "render"
  ],
  "additionalProperties": false
}
