{
  "$id": "https://vionx.app/schemas/library/item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "STATIC",
        "TEMPLATE"
      ]
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "cognitiveLevel": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "single_choice",
        "multi_choice",
        "numeric",
        "fill_blank",
        "word_bank",
        "picture_choice",
        "ordering",
        "matching",
        "true_false",
        "spelling_choice",
        "written"
      ]
    },
    "stemMd": {
      "type": "string",
      "minLength": 1
    },
    "media": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "options": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "text": {
            "type": "string"
          },
          "media": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "ttsText": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "answer": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "optionId": {
                  "type": "string"
                }
              },
              "required": [
                "optionId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "optionIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "optionIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "blanks": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": [
                "blanks"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "blankOptionIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "blankOptionIds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "order": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "order"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "pairs": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "required": [
                "pairs"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "explanationMd": {
      "default": "",
      "type": "string"
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "md": {
            "type": "string",
            "minLength": 1
          },
          "ttsText": {
            "type": "string"
          }
        },
        "required": [
          "md"
        ],
        "additionalProperties": false
      }
    },
    "workedSolutionMd": {
      "default": "",
      "type": "string"
    },
    "distractorFeedback": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "md": {
            "type": "string",
            "minLength": 1
          },
          "misconception": {
            "type": "string"
          }
        },
        "required": [
          "md"
        ],
        "additionalProperties": false
      }
    },
    "misconceptionTags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rubric": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "criteria": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxPoints": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "name",
                  "description",
                  "maxPoints"
                ],
                "additionalProperties": false
              }
            },
            "guidanceMd": {
              "type": "string"
            }
          },
          "required": [
            "criteria"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ttsText": {
      "type": "string"
    },
    "ttsLang": {
      "type": "string",
      "enum": [
        "vi",
        "en"
      ]
    },
    "group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "groupOrder": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sourceRefs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "AI_GENERATED",
        "VALIDATING",
        "NEEDS_REVIEW",
        "APPROVED",
        "PUBLISHED",
        "REJECTED",
        "ARCHIVED"
      ]
    }
  },
  "required": [
    "code",
    "kind",
    "skills",
    "difficulty",
    "cognitiveLevel",
    "type",
    "stemMd",
    "answer",
    "hints",
    "status"
  ],
  "additionalProperties": false
}
