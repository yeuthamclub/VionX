{
  "$id": "https://vionx.app/schemas/library/curriculum.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "academicYear": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "title"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "GRADE",
              "SUBJECT",
              "DOMAIN",
              "TOPIC",
              "LESSON",
              "OBJECTIVE",
              "CONCEPT",
              "SKILL"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "gdptRef": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "sortOrder": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "code",
          "parent",
          "level",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "nodes"
  ],
  "additionalProperties": false
}
